DATA_BLOCK "TwinIO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      cmd_start : Bool; // DB1.DBX0.0: 启动按钮（上位机 -> PLC 脉冲）
      cmd_stop : Bool; // DB1.DBX0.1: 停止按钮（上位机 -> PLC 脉冲）
      _pad_b0_bits : ARRAY[0..5] OF Bool; // 填充位
      out_lamp : Bool; // DB1.DBX1.0: 输出小灯状态（PLC -> 上位机：1=点亮 0=熄灭）
   END_STRUCT;

BEGIN
END_DATA_BLOCK
