{
  "schema": "tia-web-twin/manifest@1",
  "project": "plc-lamp-25d",
  "title": "启停控制与信号灯 · 2.5D 工业上位机",
  "plc": {
    "protocol": "s7",
    "ip": "192.168.0.1",
    "rack": 0,
    "slot": 1,
    "db": 1,
    "pollMs": 100
  },
  "tags": [
    {
      "id": "cmd.start",
      "address": "DB1.DBX0.0",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "启动按钮（上位机 -> PLC 脉冲）"
    },
    {
      "id": "cmd.stop",
      "address": "DB1.DBX0.1",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "停止按钮（上位机 -> PLC 脉冲）"
    },
    {
      "id": "out.lamp",
      "address": "DB1.DBX0.2",
      "type": "bool",
      "access": "r",
      "desc": "输出小灯（PLC -> 上位机：1=点亮 0=熄灭）"
    }
  ],
  "bindings": [
    { "tag": "out.lamp", "object": "indicatorLamp", "property": "lit" },
    { "tag": "cmd.start", "object": "btnStart", "property": "pressed" },
    { "tag": "cmd.stop", "object": "btnStop", "property": "pressed" }
  ]
}
